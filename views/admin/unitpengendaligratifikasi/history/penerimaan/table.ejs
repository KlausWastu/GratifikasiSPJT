<table id="example2" class="table table-bordered table-striped">
  <thead>
    <tr>
      <th>No</th>
      <th>Tanggal Lapor</th>
      <th>Tanggal Reviewed</th>
      <th>Nama Pelapor</th>
      <th>Nama Pemberi</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% for(let i=0; i< laporpenerimaan.length; i++) {%>
    <tr>
      <td><%= i+1 %></td>
      <td><%= laporpenerimaan[i].tglPembuatanLaporan %></td>
      <td><%= laporpenerimaan[i].tglPenerimaLaporan %></td>
      <td><%= laporpenerimaan[i].dataPenerima.namaPelapor %></td>
      <td><%= laporpenerimaan[i].dataPemberi.namaPemberi %></td>
      <td>
        <a
          href="/riwayatReviewedPenerimaan/down/<%= laporpenerimaan[i]._id%>"
          class="btn btn-danger"
        >
          <i class="nav-icon fa fa-file-pdf" aria-hidden="true"></i>
          Download as PDF
        </a>
      </td>
    </tr>
    <% } %>
  </tbody>
</table>
